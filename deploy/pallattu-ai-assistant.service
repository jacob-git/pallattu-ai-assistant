[Unit]
Description=Pallattu AI Assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pallattu-ai-assistant
EnvironmentFile=%h/pallattu-ai-assistant/.env
ExecStart=%h/pallattu-ai-assistant/.venv/bin/pallattu-ai-assistant
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
