[Unit]
Description=Pallattu AI Assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pallattu-ai-assistant
EnvironmentFile=/home/pi/pallattu-ai-assistant/.env
ExecStart=/home/pi/pallattu-ai-assistant/.venv/bin/pallattu-ai-assistant
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
