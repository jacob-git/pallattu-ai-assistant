OPENAI_API_KEY=

PALLATTU_LOG_LEVEL=INFO
PALLATTU_AUDIO_INPUT_DEVICE_INDEX=-1

# Wake phrase target: "Hey Pal".
# Auto-discovery prefers ~/.pallattu-ai-assistant/models/hey-pal.onnx.
# If ONNX is absent, ~/.pallattu-ai-assistant/models/hey-pal.tflite is used.
# Until either custom model exists, the built-in fallback remains "hey jarvis".
PALLATTU_WAKE_MODEL=hey jarvis
# Optional explicit custom model override (.onnx or .tflite).
# PALLATTU_WAKE_WORD_MODEL=/your/local/path/hey-pal.onnx
PALLATTU_WAKE_THRESHOLD=0.5

# Default acknowledgement after the wake word: beep, then local device speech.
PALLATTU_WAKE_ACK=beep_and_voice
PALLATTU_WAKE_ACK_TEXT=I'm listening.

# Local voice activity detection: silero (default) or webrtc.
PALLATTU_VAD_ENGINE=silero
PALLATTU_VAD_THRESHOLD=0.5
PALLATTU_WEBRTC_VAD_MODE=2
PALLATTU_END_SILENCE_SECONDS=0.8
PALLATTU_FOLLOW_UP_SECONDS=10
PALLATTU_MAX_UTTERANCE_SECONDS=20

# Default digital playback gain. Lower if audio clips; raise cautiously if needed.
PALLATTU_OUTPUT_GAIN=1.5

# Persistent local memory. Default: ~/.pallattu-ai-assistant/memory.sqlite3
# PALLATTU_MEMORY_PATH=/your/local/path/memory.sqlite3
PALLATTU_MEMORY_MAX_MESSAGES=500

# Robot movement is intentionally disabled by default.
PALLATTU_ROBOT_ACTIONS_ENABLED=false
# Optional Raspberry Pi BCM pins. Configure only after hardware is wired safely.
# PALLATTU_SERVO_PIN=18
# PALLATTU_LEFT_MOTOR_FORWARD_PIN=17
# PALLATTU_LEFT_MOTOR_BACKWARD_PIN=27
# PALLATTU_RIGHT_MOTOR_FORWARD_PIN=22
# PALLATTU_RIGHT_MOTOR_BACKWARD_PIN=23

PALLATTU_LLM_MODEL=gpt-5.6-luna
PALLATTU_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PALLATTU_TTS_MODEL=gpt-4o-mini-tts
PALLATTU_TTS_VOICE=alloy
PALLATTU_METRICS_PATH=data/usage.jsonl
