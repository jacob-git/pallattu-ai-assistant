OPENAI_API_KEY=
PICOVOICE_ACCESS_KEY=

PALLATTU_LOG_LEVEL=INFO
PALLATTU_AUDIO_INPUT_DEVICE_INDEX=-1

# Use a built-in Porcupine keyword while bootstrapping.
PALLATTU_WAKE_KEYWORD=porcupine
# For the real wake phrase, generate a Raspberry Pi .ppn in Picovoice Console.
# PALLATTU_WAKE_WORD_MODEL=/home/pi/pallattu-ai-assistant/models/hey-pallattu.ppn

PALLATTU_VAD_THRESHOLD=0.55
PALLATTU_END_SILENCE_SECONDS=0.8
PALLATTU_FOLLOW_UP_SECONDS=10
PALLATTU_MAX_UTTERANCE_SECONDS=20

PALLATTU_LLM_MODEL=gpt-5.6-luna
PALLATTU_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PALLATTU_TTS_MODEL=gpt-4o-mini-tts
PALLATTU_TTS_VOICE=coral
PALLATTU_METRICS_PATH=data/usage.jsonl
